---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <header class="post-head">
      <span class="meta">{formatDate(post.data.date)} · {post.data.author}</span>
      {post.data.draft && <span class="draft-badge">draft — not published</span>}
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-foot">
      <a href="/">← All posts</a> · Follow along via <a href="/rss.xml">RSS</a>.
    </footer>
  </article>
</Base>
